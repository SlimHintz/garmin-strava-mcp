# Bearer key for the REST API and the /tools MCP endpoint. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Public base URL clients reach the server on (used for OAuth metadata and DNS-rebinding protection)
PUBLIC_URL=https://running.example.com

# Optional
# HOST=127.0.0.1
# PORT=8787
# CREDS_DIR=/path/to/creds          # holds strava_creds.json and garmin_creds.json
# TRAINING_DB_PATH=/path/to/training.db
# OAUTH_DB_PATH=/path/to/oauth.db
